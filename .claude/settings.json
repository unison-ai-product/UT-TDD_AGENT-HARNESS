{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-guard.ts"],
            "timeout": 5,
            "statusMessage": "explicit-model + frontmatter-floor guard (env-independent TS)",
            "blockOnFailure": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/work-guard.ts"],
            "timeout": 5,
            "statusMessage": "work guard: block edits to foreign uncommitted files unless explicitly bypassed",
            "blockOnFailure": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/src/cli.ts", "session", "start"],
            "timeout": 30,
            "statusMessage": "session-log: session start (fail-open)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/src/cli.ts", "hook", "post-tool-use"],
            "timeout": 30,
            "statusMessage": "session-log: post tool use (fail-open)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/src/cli.ts", "session", "summary"],
            "timeout": 30,
            "statusMessage": "session-log: PLAN digest summary (fail-open)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/src/cli.ts", "hook", "claude-memory-wake"],
            "timeout": 930,
            "asyncRewake": true,
            "statusMessage": "HARNESS memory: Claude宛て通知を待機"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/src/cli.ts", "hook", "subagent-stop"],
            "timeout": 5,
            "statusMessage": "agent-slots: release subagent slot (fail-open)"
          }
        ]
      }
    ]
  }
}
