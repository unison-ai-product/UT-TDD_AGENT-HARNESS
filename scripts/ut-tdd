#!/usr/bin/env sh
# UT-TDD thin POSIX entrypoint. Node compiled ESM only; no runtime fallback.
set -e
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ ! -f "$ROOT/dist/ut-tdd.mjs" ]; then
  echo "UT-TDD Node bootstrap is missing. Run npm ci and npm run build." >&2
  exit 1
fi
exec node "$ROOT/dist/ut-tdd.mjs" "$@"
